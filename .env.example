# BTS.id Backend REST API - Environment Configuration Template
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000
HTTP_PORT=80
CORS_ORIGIN=*

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bts_recruitment_db
DB_USER=bts_user
DB_PASSWORD=bts_secret_password
DB_ROOT_PASSWORD=bts_root_secret_password
DB_CONNECTION_LIMIT=10

# Authentication & Security
JWT_SECRET=bts_recruitment_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=bts_recruitment_super_secret_refresh_jwt_key_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cache Settings
CACHE_TTL_SECONDS=60
