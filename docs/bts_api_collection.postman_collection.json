              "raw": "{{baseUrl}}/api/products?search=T-Shirt&category=Clothes&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "search", "value": "T-Shirt" },
                { "key": "category", "value": "Clothes" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "2. Get Product By ID",
          "request": {
            "method": "GET",
            "header": [],
